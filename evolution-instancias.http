@evolutionUrl = http://COLOQUE_O_IP_DA_VPS_AQUI:8080
@globalApiKey = COLOQUE_SUA_GLOBAL_API_KEY_AQUI
@n8nWebhookBase = https://n8n-production-e77a.up.railway.app/webhook

### ============================================================
### PASSO 1: Verificar se a VPS está de pé
### ============================================================
GET {{evolutionUrl}}/
apikey: {{globalApiKey}}

### ============================================================
### PASSO 2: Criar todas as 7 instâncias (rodar uma a uma)
### ============================================================

### 2.1 Porto Alemão
POST {{evolutionUrl}}/instance/create
Content-Type: application/json
apikey: {{globalApiKey}}

{
  "instanceName": "porto-alemao",
  "qrcode": true,
  "integration": "WHATSAPP-BAILEYS"
}

###

### 2.2 Paulo (Tapeceiro)
POST {{evolutionUrl}}/instance/create
Content-Type: application/json
apikey: {{globalApiKey}}

{
  "instanceName": "paulo-tapeceiro",
  "qrcode": true,
  "integration": "WHATSAPP-BAILEYS"
}

###

